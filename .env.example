# vibevibe-testnet-indexer example configuration
#
# Copy to .env and edit. NEVER commit a .env containing a keyed URL.
# Every value below is optional; the indexer runs with no configuration at all.
#
# TESTNET ONLY: Robinhood Chain chain ID 46630. Mainnet is not supported.

# ---------------------------------------------------------------------------
# RPC endpoint
# ---------------------------------------------------------------------------
# The public endpoint works without a key, but it is rate-limited and, critically,
# is NOT an archive node: eth_call fails beyond roughly 4,096 blocks of history.
# A keyed provider is strongly recommended for anything beyond experimentation.
#
# Example keyed form (DO NOT commit a real key):
#   RPC_URL=https://robinhood-testnet.g.alchemy.com/v2/YOUR_KEY_HERE
RPC_URL=https://rpc.testnet.chain.robinhood.com

# ---------------------------------------------------------------------------
# Scanning behaviour
# ---------------------------------------------------------------------------
# Blocks per eth_getLogs call. Adaptive: halves on either a query-time error
# ("log query timed out") or a result-count error
# ("logs matched by query exceeds limit of 10000"), then creeps back up.
# Never assume a fixed range is safe.
LOG_CHUNK_BLOCKS=20000

# Politeness delay between RPC calls, in milliseconds.
# Do not set this to 0 against a shared public endpoint.
REQUEST_DELAY_MS=150

# Retry budget for transient failures, and the exponential backoff base in ms.
# Range/result-count errors bypass retries entirely, because backing off cannot make an
# oversized query smaller; the scanner shrinks the chunk instead.
MAX_RETRIES=5
RETRY_BASE_MS=600

# ---------------------------------------------------------------------------
# Optional operator API cross-check (only used with --compare-api)
# ---------------------------------------------------------------------------
# The operator's public API is a CONVENIENCE CROSS-CHECK ONLY and is never a
# source of truth. It is rate-limited (60 req/min observed), browser-origin
# restricted, and was observed omitting recent launches from one factory
# generation. This indexer makes only a handful of read-only GETs when enabled.
VIBE_API_BASE=https://testnet.vibevibe.fun/api/v1
